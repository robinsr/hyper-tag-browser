        { "path": "UITestEnvironment.swift", "index": true, "target-membership": [ "HyperTagBrowserUITests/compile-sources" ] },
        { "path": "BaseUITest.swift", "index": true, "target-membership": [ "HyperTagBrowserUITests/compile-sources" ] },
        {
          "kind": "group",
          "path": "Scenarios",
          "children": [
            { "path": "AppLaunchTests.swift", "index": true, "target-membership": [ "HyperTagBrowserUITests/compile-sources" ] },
            { "path": "FolderLoadTests.swift", "index": true, "target-membership": [ "HyperTagBrowserUITests/compile-sources" ] },
            { "path": "TaggingTests.swift", "index": true, "target-membership": [ "HyperTagBrowserUITests/compile-sources" ] },
            { "path": "SavedQueryTests.swift", "index": true, "target-membership": [ "HyperTagBrowserUITests/compile-sources" ] },
            { "path": "BookmarkTests.swift", "index": true, "target-membership": [ "HyperTagBrowserUITests/compile-sources" ] },
          ],
        },
      ],
    }, {
      "kind": "group",
      "name": "Frameworks",
      "children": [
        { "path": "<SDK>/System/Library/Frameworks/ServiceManagement.framework", "target-membership": [ "HyperTagBrowser/frameworks" ] },
        { "path": "<SDK>/System/Library/Frameworks/AVKit.framework", "target-membership": [ "HyperTagBrowser/frameworks" ] },
        {
          "path": "<DEVELOPER>/Platforms/MacOSX.platform/Developer/Library/Frameworks/Testing.framework",
