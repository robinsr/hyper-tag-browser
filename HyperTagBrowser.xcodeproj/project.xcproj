      "build-settings": {
        "ASSETCATALOG_COMPILER_APPICON_NAME": "AppIcon",
        "ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME": "AccentColor",
        "CODE_SIGN_ENTITLEMENTS": "HyperTagBrowser/HyperTagBrowser.entitlements",
        "CODE_SIGN_IDENTITY[sdk=macosx*]": "Apple Development",
        "CODE_SIGN_STYLE": "Automatic",
        "COMBINE_HIDPI_IMAGES": "YES",
        "CURRENT_PROJECT_VERSION": "$(BUILD_NUMBER)",
        "DEAD_CODE_STRIPPING": "YES",
        "DEFINES_MODULE": "YES",
        "DEVELOPMENT_ASSET_PATHS": "\"HyperTagBrowser/Preview Content\"",
        "EMBED_ASSET_PACKS_IN_PRODUCT_BUNDLE": "YES",
        "ENABLE_HARDENED_RUNTIME": "YES",
        "ENABLE_MODULE_VERIFIER": "YES",
        "ENABLE_ON_DEMAND_RESOURCES": "NO",
        "ENABLE_PREVIEWS": "YES",
        "ENABLE_USER_SCRIPT_SANDBOXING": "NO",
        "GENERATE_INFOPLIST_FILE": "YES",
        "INFOPLIST_FILE": "HyperTagBrowser/Info.plist",
        "INFOPLIST_KEY_CFBundleDisplayName": "",
        "INFOPLIST_KEY_LSApplicationCategoryType": "public.app-category.photography",
        "INFOPLIST_KEY_NSHumanReadableCopyright": "",
        "LD_RUNPATH_SEARCH_PATHS": [
          "$(inherited)",
          "@executable_path/../Frameworks",
        ],
        "MACOSX_DEPLOYMENT_TARGET": "15.0",
        "MARKETING_VERSION": "$(VERSION)",
        "MODULE_VERIFIER_SUPPORTED_LANGUAGE_STANDARDS": "gnu17 gnu++20",
        "PRODUCT_BUNDLE_IDENTIFIER": "com.robinsr.HyperTagBrowser",
        "PRODUCT_NAME": "$(TARGET_NAME)",
        "SWIFT_ACTIVE_COMPILATION_CONDITIONS[config=Alpha]": "$(inherited)",
        "SWIFT_ACTIVE_COMPILATION_CONDITIONS[config=Beta]": "TEST $(inherited)",
        "SWIFT_ACTIVE_COMPILATION_CONDITIONS[config=Release]": "$(inherited)",
        "SWIFT_EMIT_LOC_STRINGS": "YES",
        "SWIFT_REFLECTION_METADATA_LEVEL": "all",
        "SWIFT_VERSION": "6.0",
