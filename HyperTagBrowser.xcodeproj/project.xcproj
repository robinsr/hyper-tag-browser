    {
      "kind": "group",
      "path": "HyperTagBrowser",
      "children": [
        {
          "kind": "folder",
          "path": "Resources",
          "target-membership": [
            "HyperTagBrowser",
          ],
          "membership-exceptions": [
            {
              "build-phase": "HyperTagBrowser/copy/Copy Files",
              "inclusions": [
                "LaunchAgents/com.hypertag.server.plist",
              ],
            },
          ],
        },
        { "kind": "folder", "path": "Extensions", "target-membership": [ "HyperTagBrowser" ] },
        {
          "kind": "folder",
          "path": "App",
          "target-membership": [
            "HyperTagBrowser",
          ],
          "membership-exceptions": [
            {
              "target": "HyperTagBrowser",
              "exclusions": [
                "Utilities/Watchdog.swift",
              ],
            },
          ],
        },
        { "path": "Assets.xcassets", "target-membership": [ "HyperTagBrowser/resources" ] },
        { "path": "Media.xcassets", "target-membership": [ "HyperTagBrowser/resources" ] },
        { "path": "HyperTagBrowser.entitlements" },
        {
          "kind": "group",
          "path": "Preview Content",
          "children": [
            { "path": "Preview Assets.xcassets", "target-membership": [ "HyperTagBrowser/resources" ] },
          ],
        },
      ],
    }, {
      "kind": "group",
      "path": "HyperTagBrowserTests",
      "children": [
        { "kind": "folder", "path": "TestSupport", "target-membership": [ "HyperTagBrowserTests" ] },
        { "kind": "folder", "path": "App", "target-membership": [ "HyperTagBrowserTests" ] },
        { "kind": "folder", "path": "Extensions", "target-membership": [ "HyperTagBrowserTests" ] },
      ],
    }, {
      "kind": "group",
      "path": "HyperTagBrowserUITests",
      "children": [
        {
          "kind": "group",
          "path": "Screens",
          "children": [
            { "path": "BrowseScreen.swift", "index": true, "target-membership": [ "HyperTagBrowserUITests/compile-sources" ] },
            { "path": "DetailScreen.swift", "index": true, "target-membership": [ "HyperTagBrowserUITests/compile-sources" ] },
          ],
        },
        { "path": "HyperTagBrowserUITests.swift", "target-membership": [ "HyperTagBrowserUITests/compile-sources" ] },
        { "path": "HyperTagBrowserUITestsLaunchTests.swift", "target-membership": [ "HyperTagBrowserUITests/compile-sources" ] },
        {
          "kind": "group",
          "path": "TestFixtures",
          "children": [
            {
              "kind": "group",
              "path": "Files",
              "children": [
                { "path": "uitest-image-alpha.jpg", "index": true, "target-membership": [ "HyperTagBrowserUITests/resources" ] },
                { "path": "uitest-image-beta.jpg", "index": true, "target-membership": [ "HyperTagBrowserUITests/resources" ] },
                { "path": "uitest-image-gamma.jpg", "index": true, "target-membership": [ "HyperTagBrowserUITests/resources" ] },
