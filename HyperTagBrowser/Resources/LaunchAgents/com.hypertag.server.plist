<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.hypertag.server</string>
	<key>BundleProgram</key>
	<string>Contents/MacOS/HyperTagBrowserServer</string>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>StandardOutPath</key>
	<string>/tmp/com.hypertag.server.log</string>
	<key>StandardErrorPath</key>
	<string>/tmp/com.hypertag.server.log</string>
</dict>
</plist>
